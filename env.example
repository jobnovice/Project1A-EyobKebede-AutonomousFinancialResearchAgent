# .env.example
# Project1A-EyobKebede-AutonomousFinancialResearchAgent
# Copy to .env and fill in your values. Never commit .env to git.

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_TEMPERATURE=0.1

OPENAI_API_KEY=sk-...           # Optional — used only as LLM fallback
OPENAI_MODEL=gpt-4o

MAX_TOKENS_PER_SESSION=150000   # Budget guard — triggers summarisation above this
CONTEXT_WINDOW_WARNING=120000

# ── Vector DB ─────────────────────────────────────────────────────────────────
VECTOR_DB_PROVIDER=chroma       # 'chroma' (local dev) or 'pinecone' (production)
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=ara1_research
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
MIN_SIMILARITY=0.70

PINECONE_API_KEY=               # Leave blank if using Chroma
PINECONE_INDEX=ara1

# ── External Data APIs ────────────────────────────────────────────────────────
FMP_API_KEY=                    # Financial Modeling Prep — https://financialmodelingprep.com
ALPHA_VANTAGE_KEY=              # Alpha Vantage — https://www.alphavantage.co (backup)
TAVILY_API_KEY=                 # Tavily search — https://docs.tavily.com
SERPAPI_KEY=                    # SerpAPI — https://serpapi.com (backup)
NEWSAPI_KEY=                    # NewsAPI — https://newsapi.org

SEC_USER_AGENT=Project1A-ARA1 your-email@domain.com   # Required by SEC EDGAR
SEC_RATE_LIMIT_RPS=8

# ── Agent Behaviour ───────────────────────────────────────────────────────────
MAX_ITERATIONS=20
MAX_TOOL_CALLS=20
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=1.0
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=60
USE_STUBS=true                  # Set to false only after Day 4 live API integration

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG for verbose trace output
TRACES_DIR=./logs/traces
LOG_FILE=./logs/ara1.log
TRACE_TO_FILE=true
